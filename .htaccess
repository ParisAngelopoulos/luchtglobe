# Luchtglobe on Apache (Strato). The folder settings of the main site (index page, no
# directory listings) still apply; this only adds to them.

# .geojson is JSON; without this Apache sends it without a type
<IfModule mod_mime.c>
  AddType application/geo+json .geojson
</IfModule>

# Compress the text files: data/dry.json goes from about 750 KB to about 100 KB
<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/geo+json image/svg+xml
  </IfModule>
</IfModule>
